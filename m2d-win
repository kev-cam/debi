#!/bin/bash
# m2d-win [--yes] [--target DEV] [--desktop cinnamon|mate|xfce|none]
#         [--default windows|debian] [--ntfs-rw] [--step NAME]
# Fresh Debian next to Windows on a UEFI machine: no Mint, no split.  The
# Debian partition already exists (made in Windows Disk Management) and is
# reformatted here.  Identity comes from a seed made on Windows, in
# hosts/<HOST>/seed.env (+ authorized_keys), not from an existing Linux.
#
# Steps (resumable, recorded in steps.done like the Mint flow):
#   win-survey   find the Windows ESP, the target partition, the NTFS volumes
#   win-format   ext4 on the target, GPT type set to Linux filesystem
#   win-install  debootstrap, kernel, firmware, shim/GRUB packages, desktop
#   win-users    the seeded user, ssh keys, sudo
#   win-boot     GRUB as EFI/debian on the Windows ESP; firmware order kept
#                with Windows first unless --default debian
# Without --yes it stops after printing the plan.  --step runs one step.
#
# Windows' Fast Startup leaves NTFS volumes hibernated, so they are mounted
# read-only (/mnt/c, /mnt/d, ... as in WSL) unless --ntfs-rw is given, which
# is only safe once Fast Startup is off (elevated: powercfg /h off).
. "$(dirname "$(readlink -f "$0")")/lib.sh"
# Unattended runs only have the log: never die under set -e without a word.
set -E
trap 'echo "m2d-win: failed (status $?) at line $LINENO: $BASH_COMMAND" >&2' ERR

YES= TARGET_ARG= DESKTOP= DEFAULT=windows NTFS_RW= ONLY=
while [ $# -gt 0 ]; do
    case $1 in
        --yes) YES=1; shift ;;
        --target) TARGET_ARG=$2; shift 2 ;;
        --desktop) DESKTOP=$2; shift 2 ;;
        --default) DEFAULT=$2; shift 2 ;;
        --ntfs-rw) NTFS_RW=1; shift ;;
        --step) ONLY=$2; shift 2 ;;
        -h|--help) sed -n '2,/^\. /{/^\. /d;s/^# \{0,1\}//p}' "$0"; exit 0 ;;
        *) die "unknown option $1 (see --help)" ;;
    esac
done
case $DEFAULT in windows|debian) ;; *) die "--default windows|debian" ;; esac

# ---- seed ------------------------------------------------------------------
# m2d-win-seed.ps1 writes debi\hosts\<HOST>\ on the stick's FAT partition,
# which the live session sees under /run/live/medium; import it.
# The stick can carry seeds for several machines: M2D_HOST picks one.
MEDIUM=/run/live/medium
for s in "$MEDIUM"/debi/hosts/*/seed.env; do
    [ -f "$s" ] || continue
    h=$(basename "$(dirname "$s")")
    mkdir -p "$M2D_HOME/hosts/$h"
    cp "$s" "$M2D_HOME/hosts/$h/seed.env"
    [ -f "$(dirname "$s")/authorized_keys" ] && cp "$(dirname "$s")/authorized_keys" "$M2D_HOME/hosts/$h/"
done
if [ -n "${M2D_HOST:-}" ]; then
    [ -f "$M2D_HOME/hosts/$M2D_HOST/seed.env" ] || die "no seed for M2D_HOST=$M2D_HOST"
    ln -sfn "$M2D_HOST" "$M2D_HOME/hosts/current"
elif [ ! -f "$M2D_HOME/hosts/current/seed.env" ]; then
    seeds=$(ls -d "$M2D_HOME"/hosts/*/seed.env 2>/dev/null || true)
    [ "$(wc -w <<<"$seeds")" = 1 ] || die "need one seeded host or M2D_HOST=<host> (seeds: ${seeds:-none})"
    ln -sfn "$(basename "$(dirname "$seeds")")" "$M2D_HOME/hosts/current"
fi
HOSTDIR=$(readlink -f "$M2D_HOME/hosts/current")
[ -f "$HOSTDIR/seed.env" ] || die "$HOSTDIR/seed.env missing (made on Windows, see README)"
# shellcheck disable=SC1091
. "$HOSTDIR/seed.env"
touch "$HOSTDIR/state.env"
# shellcheck disable=SC1091
. "$HOSTDIR/state.env"
DESKTOP=${DESKTOP:-${SEED_DESKTOP:-cinnamon}}

run_step() {   # run_step NAME -- skip when done, unless --step names it
    if [ -n "$ONLY" ]; then [ "$ONLY" = "$1" ]; return; fi
    ! step_done "$1"
}

# ---- win-survey ----------------------------------------------------------------
fs_empty() {   # fs_empty DEV -- no filesystem, or one holding only Windows litter
    local t n
    t=$(blkid -o value -s TYPE "$1" 2>/dev/null || true)
    [ -z "$t" ] && return 0
    mkdir -p /mnt/m2d-probe
    mount -o ro "$1" /mnt/m2d-probe 2>/dev/null || return 1
    n=$(find /mnt/m2d-probe -mindepth 1 -maxdepth 1 ! -name 'System Volume Information' \
            ! -name '$RECYCLE.BIN' ! -name 'lost+found' | wc -l)
    umount /mnt/m2d-probe
    [ "$n" = 0 ]
}
ntfs_letter() {   # ntfs_letter DEV -> C/D/... from the seed's volume serials
    local u l s
    u=$(blkid -o value -s UUID "$1" 2>/dev/null | tr a-f A-F)
    [ -n "$u" ] || return 0
    for l in $SEED_NTFS; do       # "C:9ACC2D6C D:..." (vol's serial, no dash)
        s=${l#*:}
        [ "${u: -8}" = "$s" ] && { echo "${l%%:*}"; return 0; }
    done
    return 0    # no match (e.g. the Recovery partition): empty, not a failure
}
unused_part() {   # unused_part DEV -- no filesystem at all, or our own empty deb13root
    # Never an empty NTFS/FAT volume: an empty drive with a letter is still
    # the user's drive (and NTFS serials can collide).  Name those --target.
    local t
    t=$(blkid -p -o value -s TYPE "$1" 2>/dev/null || true)
    [ -z "$t" ] && return 0
    [ "$t" = ext4 ] && [ "$(blkid -p -o value -s LABEL "$1" 2>/dev/null || true)" = "$M2D_LABEL" ] && fs_empty "$1"
}

if run_step win-survey; then
    [ -d /sys/firmware/efi ] || die "the live session booted BIOS; boot the stick in UEFI mode (Windows is UEFI)"
    command -v efibootmgr >/dev/null || die "efibootmgr missing (go.sh installs it)"
    live_src=$(findmnt -no SOURCE "$MEDIUM" 2>/dev/null || true)
    live_disk=; [ -b "$live_src" ] && live_disk=$(lsblk -no PKNAME "$live_src" | head -1)

    # Windows ESP: the vfat partition holding the Windows boot manager.
    esp=
    for p in $(lsblk -lnpo NAME,FSTYPE | awk '$2=="vfat"{print $1}'); do
        [ "$(lsblk -no PKNAME "$p")" = "$live_disk" ] && continue
        mkdir -p /mnt/m2d-probe
        mount -o ro "$p" /mnt/m2d-probe 2>/dev/null || continue
        [ -f /mnt/m2d-probe/EFI/Microsoft/Boot/bootmgfw.efi ] && esp=$p
        free=$(df -m --output=avail /mnt/m2d-probe | tail -1 | tr -d ' ')
        umount /mnt/m2d-probe
        [ -n "$esp" ] && break
    done
    [ -n "$esp" ] || die "no ESP with EFI/Microsoft/Boot/bootmgfw.efi found"
    [ "$free" -ge 12 ] || die "ESP $esp has only ${free} MiB free; shim+GRUB need ~12"

    # Target: --target, else on the disk holding the seed's
    # SEED_TARGET_SIBLING NTFS volume (G: on P620A): one partition of 20 GiB
    # or more with no filesystem (or our own empty deb13root), or failing
    # that the largest free region of 20 GiB or more, where win-format
    # creates the partition.
    tgt= free_start= free_size=
    if [ -n "$TARGET_ARG" ]; then tgt=$TARGET_ARG
    else
        sib=
        for p in $(lsblk -lnpo NAME,FSTYPE | awk '$2=="ntfs"{print $1}'); do
            [ "$(ntfs_letter "$p")" = "${SEED_TARGET_SIBLING:-}" ] && sib="$sib $p"
        done
        sib=${sib# }
        [ -n "$sib" ] || die "can't find the ${SEED_TARGET_SIBLING:-?}: volume; pass --target"
        [ "$(wc -w <<<"$sib")" = 1 ] || die "several partitions carry ${SEED_TARGET_SIBLING}:'s serial ($sib); pass --target"
        disk=/dev/$(lsblk -no PKNAME "$sib")
        cands=
        for p in $(lsblk -lnpo NAME,TYPE "$disk" | awk '$2=="part"{print $1}'); do
            [ "$p" = "$sib" ] && continue
            [ "$(( $(blockdev --getsize64 "$p") >> 30 ))" -ge 20 ] || continue   # skips MSR
            unused_part "$p" && cands="$cands $p"
        done
        case $(wc -w <<<"$cands") in
            1) tgt=${cands# } ;;
            0) ss=$(blockdev --getss "$disk")
               read -r free_start free_size < <(sfdisk --list-free "$disk" |
                   awk '$1~/^[0-9]+$/ && $2~/^[0-9]+$/ {print $1, $3}' | sort -k2,2n | tail -1) || true
               [ -n "$free_size" ] && [ $(( free_size * ss >> 30 )) -ge 20 ] \
                   || die "no empty partition or free space of 20 GiB+ on $disk; pass --target" ;;
            *) die "several empty partitions beside $sib:$cands; pass --target" ;;
        esac
    fi
    if [ -n "$tgt" ]; then
        [ -b "$tgt" ] || die "$tgt is not a block device"
        findmnt -S "$tgt" >/dev/null && die "$tgt is mounted"
        l=$(ntfs_letter "$tgt")
        [ -z "$l" ] || die "$tgt is Windows drive $l: (serial in the seed); refusing"
        if ! fs_empty "$tgt"; then
            [ "$(blkid -o value -s LABEL "$tgt")" = "$M2D_LABEL" ] && step_done win-format \
                || die "$tgt is not empty and not ours; refusing to format it"
        fi
        disk=/dev/$(lsblk -no PKNAME "$tgt")
        set_state DEB_PARTN "$(cat "/sys/class/block/$(basename "$tgt")/partition")"
    fi
    [ "$disk" = "/dev/$live_disk" ] && die "the target is on the live stick"

    set_state HOST "$SEED_HOST"
    set_state DEB_DEV "$tgt"
    set_state DISK "$disk"
    set_state FREE_START "$free_start"
    set_state FREE_SECTORS "$free_size"
    set_state ESP_DEV "$esp"
    set_state ESP_UUID "$(blkid -o value -s UUID "$esp")"
    set_state BOOTMODE uefi
    grep -q '^EFI_BOOTORDER_ORIG=' "$HOSTDIR/state.env" || {
        set_state EFI_BOOTORDER_ORIG "$(efibootmgr | sed -n 's/^BootOrder: //p')"
        efibootmgr -v > "$HOSTDIR/efibootmgr-before.txt" 2>/dev/null || true
    }
    ntfs=
    for p in $(lsblk -lnpo NAME,FSTYPE | awk '$2=="ntfs"{print $1}'); do
        l=$(ntfs_letter "$p"); [ -n "$l" ] && ntfs="$ntfs ${l}:$(blkid -o value -s UUID "$p")"
    done
    set_state NTFS_VOLS "${ntfs# }"

    cat <<EOF

  host        $SEED_HOST (fresh Debian $M2D_SUITE beside Windows, UEFI)
  target      $(if [ -n "$tgt" ]; then echo "$tgt  ($(( $(blockdev --getsize64 "$tgt") >> 30 )) GiB, partition $DEB_PARTN of $DISK, empty)"
                else echo "new partition in free space on $DISK  ($(( free_size * ss >> 30 )) GiB from sector $free_start)"; fi)  -> ext4 '$M2D_LABEL'
  ESP         $esp  (${free} MiB free; Windows boot manager stays)
  NTFS        ${ntfs# }  -> /mnt/<letter> $([ -n "$NTFS_RW" ] && echo rw || echo 'read-only (Fast Startup)')
  user        $SEED_USER (uid $SEED_UID), desktop $DESKTOP
  boots first $DEFAULT   (firmware BootOrder now $EFI_BOOTORDER_ORIG)
EOF
    mark_done win-survey
fi
. "$HOSTDIR/state.env"

if [ -z "$YES" ] && [ -z "$ONLY" ]; then
    what="format $DEB_DEV"; [ -n "$DEB_DEV" ] || what="partition $DISK, format"
    echo; echo "Plan only.  Rerun with --yes to $what and install."; exit 0
fi

# ---- win-format -----------------------------------------------------------------
if run_step win-format; then
    if [ -z "$DEB_DEV" ]; then
        log "creating a Linux partition in the free space on $DISK"
        sfdisk -d "$DISK" > "$HOSTDIR/ptable-before.sfdisk"
        before=$(lsblk -lnpo NAME,TYPE "$DISK" | awk '$2=="part"{print $1}')
        echo "$FREE_START,$FREE_SECTORS,L" | sfdisk --append --no-reread "$DISK"
        partx -u "$DISK" 2>/dev/null || partprobe "$DISK"; udevadm settle
        new=$(comm -13 <(echo "$before") <(lsblk -lnpo NAME,TYPE "$DISK" | awk '$2=="part"{print $1}'))
        [ "$(wc -w <<<"$new")" = 1 ] || die "couldn't identify the new partition (got: '$new')"
        set_state DEB_DEV "$new"
        set_state DEB_PARTN "$(cat "/sys/class/block/$(basename "$new")/partition")"
    fi
    l=$(ntfs_letter "$DEB_DEV")
    [ -z "$l" ] || die "$DEB_DEV is Windows drive $l:; refusing"
    fs_empty "$DEB_DEV" || [ "$(blkid -o value -s LABEL "$DEB_DEV")" = "$M2D_LABEL" ] \
        || die "$DEB_DEV is no longer empty; refusing"
    log "formatting $DEB_DEV as ext4 ($M2D_LABEL)"
    wipefs -a "$DEB_DEV"
    mkfs.ext4 -F -L "$M2D_LABEL" "$DEB_DEV"
    # Linux filesystem type, so Windows doesn't offer to format it
    if [ "$(blkid -o value -s PTTYPE "$DISK")" = gpt ]; then
        sfdisk --part-type "$DISK" "$DEB_PARTN" 0FC63DAF-8483-4772-8E79-3D69D8477DE4
    fi
    set_state DEB_UUID "$(blkid -o value -s UUID "$DEB_DEV")"
    mark_done win-format
fi
. "$HOSTDIR/state.env"

# ---- win-install -----------------------------------------------------------------
if run_step win-install; then
    command -v debootstrap >/dev/null || die "debootstrap missing (go.sh installs it)"
    mount_target
    if [ ! -x "$TARGET/usr/bin/apt-get" ]; then
        log "debootstrap $M2D_SUITE -> $DEB_DEV"
        debootstrap --arch=amd64 --components=main,contrib,non-free,non-free-firmware \
            --include=locales,ca-certificates,apt-transport-https \
            "$M2D_SUITE" "$TARGET" "$M2D_MIRROR"
    fi
    target_setup
    cat > "$TARGET/etc/apt/sources.list.d/debian.sources" <<EOF
Types: deb
URIs: $M2D_MIRROR
Suites: $M2D_SUITE $M2D_SUITE-updates
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security
Suites: $M2D_SUITE-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
    : > "$TARGET/etc/apt/sources.list"

    echo "$SEED_HOST" > "$TARGET/etc/hostname"
    printf '127.0.0.1\tlocalhost\n127.0.1.1\t%s\n::1\tlocalhost ip6-localhost ip6-loopback\n' "$SEED_HOST" > "$TARGET/etc/hosts"
    echo "$SEED_TZ" > "$TARGET/etc/timezone"
    ln -sf "/usr/share/zoneinfo/$SEED_TZ" "$TARGET/etc/localtime"
    # Windows keeps the RTC in local time; say so, or the clock jumps by the
    # UTC offset on every switch between the two.
    printf '0.0 0 0.0\n0\nLOCAL\n' > "$TARGET/etc/adjtime"
    echo "$SEED_LANG ${SEED_LANG#*.}" > "$TARGET/etc/locale.gen"
    echo "LANG=$SEED_LANG" > "$TARGET/etc/default/locale"
    in_target locale-gen
    cat > "$TARGET/etc/default/keyboard" <<EOF
XKBMODEL="pc105"
XKBLAYOUT="$SEED_KBD"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF

    ntfsopt=ro; [ -n "$NTFS_RW" ] && ntfsopt=rw
    {
        echo "# generated by m2d-win for $SEED_HOST"
        echo "UUID=$DEB_UUID  /  ext4  errors=remount-ro  0  1"
        echo "UUID=$ESP_UUID  /boot/efi  vfat  umask=0077  0  1"
        echo "/swapfile  none  swap  sw  0  0"
        echo "# Windows volumes at the WSL paths.  ro while Windows Fast Startup is on."
        for v in $NTFS_VOLS; do
            l=${v%%:*}; l=${l,,}
            echo "UUID=${v#*:}  /mnt/$l  ntfs3  $ntfsopt,nofail,uid=$SEED_UID,gid=$SEED_UID,windows_names,x-systemd.device-timeout=10s  0  0"
            mkdir -p "$TARGET/mnt/$l"
        done
    } > "$TARGET/etc/fstab"
    mkdir -p "$TARGET/boot/efi"
    [ -f "$TARGET/swapfile" ] || { fallocate -l 8G "$TARGET/swapfile"; chmod 600 "$TARGET/swapfile"; mkswap "$TARGET/swapfile"; }
    mkdir -p "$TARGET/etc/initramfs-tools/conf.d"
    echo RESUME=none > "$TARGET/etc/initramfs-tools/conf.d/resume"

    # GRUB's postinst must not reorder the firmware boot list behind our back.
    in_target debconf-set-selections <<EOF
keyboard-configuration keyboard-configuration/layoutcode string $SEED_KBD
grub-efi-amd64 grub2/update_nvram boolean $([ "$DEFAULT" = debian ] && echo true || echo false)
EOF
    tapt update
    tapt install linux-image-amd64 grub-efi-amd64 grub-efi-amd64-signed shim-signed \
        efibootmgr os-prober network-manager openssh-server sudo console-setup
    install_best_effort base amd64-microcode intel-microcode firmware-linux firmware-linux-nonfree \
        firmware-misc-nonfree firmware-realtek firmware-amd-graphics firmware-iwlwifi \
        firmware-atheros firmware-brcm80211 bash-completion rsync curl wget less vim-tiny \
        man-db dosfstools ntfs-3g qemu-utils build-essential git cmake ninja-build \
        pkg-config python3 python3-venv
    case ${DESKTOP,,} in
        none) ;;
        mate|xfce|cinnamon)
            log "installing task-${DESKTOP,,}-desktop"
            tapt install "task-${DESKTOP,,}-desktop" lightdm
            install_best_effort desktop slick-greeter ;;
        *) die "unknown --desktop $DESKTOP" ;;
    esac
    target_teardown
    cleanup_mounts
    mark_done win-install
fi

# ---- win-users --------------------------------------------------------------------
if run_step win-users; then
    target_setup
    u=$SEED_USER
    in_target getent group "$u" >/dev/null || in_target groupadd -g "$SEED_UID" "$u"
    in_target id "$u" >/dev/null 2>&1 || \
        in_target useradd -m -u "$SEED_UID" -g "$SEED_UID" -c "${SEED_GECOS:-}" -s /bin/bash "$u"
    for g in sudo adm audio video plugdev netdev bluetooth dialout; do
        in_target getent group "$g" >/dev/null && in_target usermod -aG "$g" "$u"
    done
    # The seed's keys, plus whatever the stick's root accepts (whoever drives
    # the stick over ssh can reach the result).
    cat "$HOSTDIR/authorized_keys" /root/.ssh/authorized_keys 2>/dev/null \
        | grep -E '^(ssh|ecdsa|sk-)' | sort -u > "$HOSTDIR/.keys" || true
    if [ -s "$HOSTDIR/.keys" ]; then
        for d in "/home/$u" /root; do
            install -d -m 700 "$TARGET$d/.ssh"
            install -m 600 "$HOSTDIR/.keys" "$TARGET$d/.ssh/authorized_keys"
        done
        in_target chown -R "$u:$u" "/home/$u/.ssh"
    fi
    rm -f "$HOSTDIR/.keys"
    # SEED_PASSWORD is for throwaway install passwords only (installer/
    # installer, changed afterwards).  Otherwise ask at the console; with no
    # console the account is ssh-key only until 'passwd' is run.
    if [ -n "${SEED_PASSWORD:-}" ]; then
        echo "$u:$SEED_PASSWORD" | in_target chpasswd
    elif in_target passwd -S "$u" | awk '{exit !($2=="L"||$2=="NP")}'; then
        if [ -t 0 ]; then
            echo "Set the Debian password for $u:"
            until in_target passwd "$u"; do :; done
        else
            in_target passwd -l "$u" >/dev/null
            warn "$u has no password (ssh keys only); run 'passwd $u' in Debian"
            echo "password: not set (no tty); ssh keys only" >> "$HOSTDIR/report.txt"
        fi
    fi
    target_teardown
    cleanup_mounts
    mark_done win-users
fi

# ---- win-boot ------------------------------------------------------------------------
if run_step win-boot; then
    target_setup
    do_mount "$ESP_DEV" "$TARGET/boot/efi"
    dg=$TARGET/etc/default/grub
    setg() { if grep -q "^$1=" "$dg"; then sed -i "s|^$1=.*|$1=$2|" "$dg"; else echo "$1=$2" >> "$dg"; fi; }
    setg GRUB_TIMEOUT 5
    setg GRUB_TIMEOUT_STYLE menu
    setg GRUB_DISABLE_OS_PROBER false

    log "installing shim + GRUB as EFI/debian on $ESP_DEV"
    in_target grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=debian
    in_target update-initramfs -u -k all
    in_target update-grub

    v=$(efibootmgr)
    deb=$(sed -n 's/^Boot\([0-9A-F]\{4\}\)\*\{0,1\} debian.*/\1/p' <<<"$v" | head -1)
    win=$(sed -n 's/^Boot\([0-9A-F]\{4\}\)\*\{0,1\} Windows Boot Manager.*/\1/p' <<<"$v" | head -1)
    [ -n "$deb" ] || die "no 'debian' firmware entry after grub-install"
    rest=$(sed -n 's/^BootOrder: //p' <<<"$v" | tr ',' '\n' | grep -vxE "$deb|${win:-none}" | paste -sd, -)
    if [ "$DEFAULT" = windows ] && [ -n "$win" ]; then order=$win,$deb${rest:+,$rest}
    else order=$deb${win:+,$win}${rest:+,$rest}; fi
    efibootmgr -q -o "$order"
    set_state EFI_DEBIAN "$deb"
    set_state EFI_WINDOWS "${win:-}"
    log "firmware BootOrder $order (was $EFI_BOOTORDER_ORIG)"

    cat > "$TARGET/usr/local/sbin/win-bootctl" <<EOF
#!/bin/sh
# win-bootctl next|default windows|debian  -- written by m2d-win
# 'next' boots that OS once; 'default' changes the firmware BootOrder.
set -e
deb=$deb win=${win:-}
case \$2 in windows) n=\$win o=\$win,\$deb ;; debian) n=\$deb o=\$deb,\$win ;; *) echo "usage: \$0 next|default windows|debian" >&2; exit 2 ;; esac
case \$1 in
    next)    efibootmgr -q -n "\$n" && echo "next boot: \$2 (Boot\$n)" ;;
    default) rest=\$(efibootmgr | sed -n 's/^BootOrder: //p' | tr ',' '\n' | grep -vxE "\$deb|\$win" | paste -sd, -)
             efibootmgr -q -o "\$o\${rest:+,\$rest}" && echo "default: \$2" ;;
    *) echo "usage: \$0 next|default windows|debian" >&2; exit 2 ;;
esac
EOF
    chmod +x "$TARGET/usr/local/sbin/win-bootctl"
    target_teardown
    cleanup_mounts
    mark_done win-boot
fi

# Leave the record where Windows can read it: debi\hosts\<HOST>\ on the stick.
if [ -d "$MEDIUM/debi" ] && mount -o remount,rw "$MEDIUM" 2>/dev/null; then
    out=$MEDIUM/debi/hosts/$SEED_HOST
    mkdir -p "$out"
    cp -f "$HOSTDIR"/state.env "$HOSTDIR"/steps.done "$out/" 2>/dev/null || true
    cp -f "$HOSTDIR"/*.txt "$HOSTDIR"/*.sfdisk "$out/" 2>/dev/null || true
    mount -o remount,ro "$MEDIUM" 2>/dev/null || true
fi

if step_done win-boot; then
    cat <<EOF

All m2d-win steps done for $SEED_HOST.
  Firmware boots $DEFAULT first.  From Windows (elevated): boot-debian.ps1
  From Debian: win-bootctl next windows|debian, win-bootctl default ...
Remove the stick and reboot.
EOF
fi
