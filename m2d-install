#!/bin/bash
# m2d-install
# debootstrap Debian ($M2D_SUITE) into the new partition and install the base
# system, kernel, firmware and the desktop matching the Mint edition.
# Locale/keyboard/timezone/hostname are taken from Mint.
. "$(dirname "$(readlink -f "$0")")/lib.sh"
load_state
command -v debootstrap >/dev/null || die "debootstrap missing (m2d-prep-usb installs it)"
[ -n "${DEB_DEV:-}" ] || die "run m2d-split first"

mount_mint ro
mount_target

if [ ! -x "$TARGET/usr/bin/apt-get" ]; then
    log "debootstrap $M2D_SUITE -> $DEB_DEV"
    debootstrap --arch=amd64 --components=main,contrib,non-free,non-free-firmware \
        --include=locales,ca-certificates,apt-transport-https \
        "$M2D_SUITE" "$TARGET" "$M2D_MIRROR"
fi
target_setup

cat > "$TARGET/etc/apt/sources.list.d/debian.sources" <<EOF
Types: deb
URIs: $M2D_MIRROR
Suites: $M2D_SUITE $M2D_SUITE-updates
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: http://security.debian.org/debian-security
Suites: $M2D_SUITE-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
: > "$TARGET/etc/apt/sources.list"

# ---- identity + locale from Mint --------------------------------------------
cp "$MINT/etc/hostname" "$TARGET/etc/hostname"
cp "$MINT/etc/hosts" "$TARGET/etc/hosts"
tz=$(cat "$MINT/etc/timezone" 2>/dev/null || readlink "$MINT/etc/localtime" | sed 's|.*/zoneinfo/||')
echo "$tz" > "$TARGET/etc/timezone"
ln -sf "/usr/share/zoneinfo/$tz" "$TARGET/etc/localtime"
cp "$MINT/etc/default/keyboard" "$TARGET/etc/default/keyboard"
lang=$(sed -n 's/^LANG="\?\([^"]*\)"\?/\1/p' "$MINT/etc/default/locale" 2>/dev/null); lang=${lang:-en_US.UTF-8}
grep -vE '^\s*#|^\s*$' "$MINT/etc/locale.gen" 2>/dev/null > "$TARGET/etc/locale.gen" || true
grep -q "^$lang" "$TARGET/etc/locale.gen" || echo "$lang ${lang#*.}" >> "$TARGET/etc/locale.gen"
echo "LANG=$lang" > "$TARGET/etc/default/locale"
in_target locale-gen

# ---- fstab ------------------------------------------------------------------
{
    echo "# generated by mint2deb from $MINT_HOST's Mint fstab"
    echo "UUID=$DEB_UUID  /  ext4  errors=remount-ro  0  1"
    awk '$1!~/^#/ && NF>=4 && $2!="/" && $2!="/boot"' "$MINT/etc/fstab"
} > "$TARGET/etc/fstab"
# A Mint /swapfile lives on the Mint root -- give Debian its own.
if awk '$1=="/swapfile"' "$MINT/etc/fstab" | grep -q . && [ ! -f "$TARGET/swapfile" ]; then
    sz=$(stat -c %s "$MINT/swapfile" 2>/dev/null || echo 2147483648)
    fallocate -l "$sz" "$TARGET/swapfile"; chmod 600 "$TARGET/swapfile"; mkswap "$TARGET/swapfile"
fi
# Swap may be shared with Mint: never resume from it.
mkdir -p "$TARGET/etc/initramfs-tools/conf.d"
echo RESUME=none > "$TARGET/etc/initramfs-tools/conf.d/resume"

# ---- packages ---------------------------------------------------------------
# Don't let grub-pc's postinst write any MBR -- m2d-boot does that deliberately.
in_target debconf-set-selections <<EOF
grub-pc grub-pc/install_devices multiselect
grub-pc grub-pc/install_devices_empty boolean true
keyboard-configuration keyboard-configuration/layoutcode string $(sed -n 's/^XKBLAYOUT="\(.*\)"/\1/p' "$MINT/etc/default/keyboard")
EOF
tapt update
case $BOOTMODE in
    uefi) grubpkgs="grub-efi-amd64 efibootmgr" ;;
    *)    grubpkgs="grub-pc" ;;
esac
tapt install linux-image-amd64 $grubpkgs os-prober network-manager openssh-server sudo console-setup
install_best_effort base firmware-linux firmware-linux-nonfree firmware-misc-nonfree     firmware-realtek firmware-amd-graphics firmware-iwlwifi firmware-atheros firmware-brcm80211     bash-completion rsync curl wget less vim-tiny man-db dosfstools ntfs-3g autofs

case ${MINT_EDITION,,} in
    *mate*)     desktop=task-mate-desktop ;;
    *xfce*)     desktop=task-xfce-desktop ;;
    *cinnamon*) desktop=task-cinnamon-desktop ;;
    *)          desktop=task-cinnamon-desktop; warn "unknown Mint edition '$MINT_EDITION', using Cinnamon" ;;
esac
log "installing $desktop"
tapt install "$desktop" lightdm
install_best_effort desktop slick-greeter

target_teardown
mark_done install
log "base system installed.  Next: m2d-migrate"
